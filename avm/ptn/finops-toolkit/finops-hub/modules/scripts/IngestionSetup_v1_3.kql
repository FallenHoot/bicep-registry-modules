//======================================================================================================================
// Ingestion database / FOCUS 1.3 transforms
// Extends v1_2 transforms with FOCUS 1.3 columns.
// New CostAndUsage columns: ServiceProviderName, HostProviderName, ContractApplied,
//   AllocatedMethodDetails, AllocatedMethodId, AllocatedResourceId, AllocatedResourceName, AllocatedTags
// Deprecated columns retained for backward compatibility: ProviderName, PublisherName
//======================================================================================================================

// For allowed commands, see https://learn.microsoft.com/azure/data-explorer/database-script


//===| Prices |=========================================================================================================
// Prices schema is unchanged in FOCUS 1.3 — wrap v1.2 transform directly.
//======================================================================================================================

// Prices_transform_v1_3 function
.create-or-alter function
with (docstring='Transforms Prices_raw into FOCUS 1.3.', folder='Prices')
Prices_transform_v1_3()
{
    Prices_transform_v1_2()
}

// Prices_final_v1_3 table — same schema as v1_2
.create-merge table Prices_final_v1_3 (
    BillingAccountId:                    string,
    BillingAccountName:                  string,
    BillingCurrency:                     string,
    ChargeCategory:                      string,
    CommitmentDiscountCategory:          string,
    CommitmentDiscountType:              string,
    CommitmentDiscountUnit:              string,
    ContractedUnitPrice:                 real,
    ListUnitPrice:                       real,
    PricingCategory:                     string,
    PricingCurrency:                     string,
    PricingUnit:                         string,
    SkuId:                               string,
    SkuMeter:                            string,
    SkuPriceId:                          string,
    SkuPriceIdv2:                        string,
    x_BaseUnitPrice:                     real,
    x_BillingAccountAgreement:           string,
    x_BillingAccountId:                  string,
    x_BillingProfileId:                  string,
    x_CommitmentDiscountNormalizedRatio: real,
    x_CommitmentDiscountSpendEligibility:  string,
    x_CommitmentDiscountUsageEligibility:  string,
    x_ContractedUnitPriceDiscount:       real,
    x_ContractedUnitPriceDiscountPercent:real,
    x_EffectivePeriodEnd:                datetime,
    x_EffectivePeriodStart:              datetime,
    x_EffectiveUnitPrice:                real,
    x_EffectiveUnitPriceDiscount:        real,
    x_EffectiveUnitPriceDiscountPercent: real,
    x_IngestionTime:                     datetime,
    x_PricingBlockSize:                  real,
    x_PricingSubcategory:                string,
    x_PricingUnitDescription:            string,
    x_SkuDescription:                    string,
    x_SkuId:                             string,
    x_SkuIncludedQuantity:               real,
    x_SkuMeterCategory:                  string,
    x_SkuMeterId:                        string,
    x_SkuMeterSubcategory:               string,
    x_SkuMeterType:                      string,
    x_SkuPriceType:                      string,
    x_SkuProductId:                      string,
    x_SkuRegion:                         string,
    x_SkuServiceFamily:                  string,
    x_SkuOfferId:                        string,
    x_SkuPartNumber:                     string,
    x_SkuTerm:                           int,
    x_SkuTier:                           real,
    x_SourceName:                        string,
    x_SourceProvider:                    string,
    x_SourceType:                        string,
    x_SourceVersion:                     string,
    x_TotalUnitPriceDiscount:            real,
    x_TotalUnitPriceDiscountPercent:     real
)

// Update policy for Prices_raw -> Prices_final_v1_3
.alter table Prices_final_v1_3 policy update
```
[{
    "IsEnabled": true,
    "Source": "Prices_raw",
    "Query": "Prices_transform_v1_3()",
    "IsTransactional": false,
    "PropagateIngestionProperties": true,
    "ManagedIdentity": null
}]
```


//===| Costs |==========================================================================================================
// FOCUS 1.3 adds: ServiceProviderName, HostProviderName, ContractApplied,
//   AllocatedMethodDetails, AllocatedMethodId, AllocatedResourceId, AllocatedResourceName, AllocatedTags
//======================================================================================================================

// Costs_transform_v1_3 function
.create-or-alter function
with (docstring='Transforms Costs_raw into FOCUS 1.3.', folder='Costs')
Costs_transform_v1_3()
{
    Costs_transform_v1_2()
    // Add FOCUS 1.3 columns
    | extend ServiceProviderName = ProviderName
    | extend HostProviderName = PublisherName
    | extend ContractApplied = ''
    | extend AllocatedMethodDetails = ''
    | extend AllocatedMethodId = ''
    | extend AllocatedResourceId = ''
    | extend AllocatedResourceName = ''
    | extend AllocatedTags = dynamic({})
}

// ActualCosts_transform_v1_3 function
.create-or-alter function
with (docstring='Transforms ActualCosts_raw into FOCUS 1.3.', folder='Costs')
ActualCosts_transform_v1_3()
{
    ActualCosts_transform_v1_2()
    // Add FOCUS 1.3 columns
    | extend ServiceProviderName = ProviderName
    | extend HostProviderName = PublisherName
    | extend ContractApplied = ''
    | extend AllocatedMethodDetails = ''
    | extend AllocatedMethodId = ''
    | extend AllocatedResourceId = ''
    | extend AllocatedResourceName = ''
    | extend AllocatedTags = dynamic({})
}

// AmortizedCosts_transform_v1_3 function
.create-or-alter function
with (docstring='Transforms AmortizedCosts_raw into FOCUS 1.3.', folder='Costs')
AmortizedCosts_transform_v1_3()
{
    AmortizedCosts_transform_v1_2()
    // Add FOCUS 1.3 columns
    | extend ServiceProviderName = ProviderName
    | extend HostProviderName = PublisherName
    | extend ContractApplied = ''
    | extend AllocatedMethodDetails = ''
    | extend AllocatedMethodId = ''
    | extend AllocatedResourceId = ''
    | extend AllocatedResourceName = ''
    | extend AllocatedTags = dynamic({})
}

